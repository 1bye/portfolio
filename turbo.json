{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "check-types": {
      "dependsOn": ["transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@portfolio/infra#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "ALCHEMY_*",
        "CI",
        "CLOUDFLARE_*",
        "DO_NOT_TRACK",
        "NO_TRACK",
        "USER"
      ]
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false,
      "passThroughEnv": [
        "ALCHEMY_*",
        "CI",
        "CLOUDFLARE_*",
        "DO_NOT_TRACK",
        "NO_TRACK",
        "USER"
      ]
    },
    "destroy:stage": {
      "cache": false,
      "passThroughEnv": [
        "ALCHEMY_*",
        "CI",
        "CLOUDFLARE_*",
        "DO_NOT_TRACK",
        "NO_TRACK",
        "USER"
      ]
    },
    "plan": {
      "cache": false,
      "passThroughEnv": [
        "ALCHEMY_*",
        "CI",
        "CLOUDFLARE_*",
        "DO_NOT_TRACK",
        "NO_TRACK",
        "USER"
      ]
    }
  }
}
